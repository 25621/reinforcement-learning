<?xml version="1.0"?>
<!--
  arm6 - a 6-DoF industrial-style arm with a SPHERICAL WRIST.

  "Spherical wrist" means the last three joint axes all pass through one
  point (here: the origin of wrist_2_link).  That single geometric choice is
  what lets an inverse-kinematics solver split the problem in two - position
  is decided by joints 1-3, orientation by joints 4-6 - and it is why almost
  every industrial arm is built this way.

  All joint origins are pure translations along the parent's z axis, which
  keeps the file readable.  Joint axes alternate z, y, y, z, y, z.

  Units: metres, radians, kilograms.  Angles in <origin rpy> are FIXED-axis
  roll-pitch-yaw, i.e. R = Rz(yaw) Ry(pitch) Rx(roll).
-->
<robot name="arm6">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="4.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.085" length="0.20"/></geometry>
    </visual>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.075" length="0.10"/></geometry>
    </visual>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0 0 0.21"/>
      <mass value="6.0"/>
      <inertia ixx="0.10" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.21"/>
      <geometry><cylinder radius="0.058" length="0.42"/></geometry>
    </visual>
  </link>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0 0 0.19"/>
      <mass value="3.5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.19"/>
      <geometry><cylinder radius="0.046" length="0.38"/></geometry>
    </visual>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="1.2"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.045"/>
      <geometry><cylinder radius="0.040" length="0.09"/></geometry>
    </visual>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.9"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.038" length="0.05"/></geometry>
    </visual>
  </link>

  <link name="wrist_3_link">
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.030" length="0.12"/></geometry>
    </visual>
  </link>

  <!-- The tool frame: where the gripper actually touches the world.  It is a
       FIXED joint, so it adds no degree of freedom - it only renames a point. -->
  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.90" upper="2.90" effort="150" velocity="3.0"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="150" velocity="3.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.80" upper="2.80" effort="120" velocity="3.2"/>
  </joint>

  <joint name="wrist_1" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.38" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.00" upper="3.00" effort="40" velocity="3.2"/>
  </joint>

  <joint name="wrist_2" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.00" upper="2.00" effort="40" velocity="3.2"/>
  </joint>

  <!-- Zero offset: wrist_3 shares its origin with wrist_2, so axes 4, 5 and 6
       all meet at one point.  THAT is the spherical wrist. -->
  <joint name="wrist_3" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.00" upper="3.00" effort="40" velocity="3.2"/>
  </joint>

  <joint name="tool_fixed" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

</robot>
