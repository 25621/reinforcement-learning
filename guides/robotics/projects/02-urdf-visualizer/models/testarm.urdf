<?xml version="1.0"?>
<!--
  testarm - a deliberately AWKWARD robot, built as a test fixture.

  arm6 and arm7 are pretty: every joint origin is a pure translation along z
  and every axis is x, y or z.  That makes them easy to read - and useless for
  testing, because several classic kinematics bugs are INVISIBLE on a robot
  whose origin rotations are all identity.  Transpose a rotation that happens
  to be the identity and nothing changes.

  So this robot breaks every symmetry on purpose:
    * every joint origin has a non-zero rpy (a real rotation, not just a shift)
    * joint axes point in arbitrary directions, not along x/y/z
    * one axis is written NON-UNIT ("0 2 0") - a loader that forgets to
      normalise it will silently double that joint's angle
    * one joint is PRISMATIC (it slides instead of turning)
    * the tree BRANCHES: link2 carries both the rest of the arm and a camera

  Nothing here needs to look like a real machine.  It needs to make wrong code
  produce a visibly wrong answer, which is a completely different goal.
-->
<robot name="testarm">

  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry></visual>
  </link>

  <link name="link1">
    <inertial><origin xyz="0 0 0.05"/><mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.045" length="0.12"/></geometry></visual>
  </link>

  <link name="link2">
    <inertial><origin xyz="0 0.05 0"/><mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.040" length="0.14"/></geometry></visual>
  </link>

  <link name="camera_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
    <visual><origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.09 0.04"/></geometry></visual>
  </link>

  <link name="link3">
    <inertial><origin xyz="0 0 0.09"/><mass value="0.8"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial>
    <visual><origin xyz="0 0 0.09"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry></visual>
  </link>

  <link name="link4">
    <inertial><origin xyz="0 0 0.06"/><mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.030" length="0.14"/></geometry></visual>
  </link>

  <link name="link5">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.026" length="0.10"/></geometry></visual>
  </link>

  <link name="tool0">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0 0 0"/><geometry><sphere radius="0.022"/></geometry></visual>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0.02 -0.01 0.10" rpy="0.20 -0.35 0.90"/>
    <axis xyz="0.3 0.5 0.81"/>
    <limit lower="-2.5" upper="2.5" effort="50" velocity="3"/>
  </joint>

  <!-- A PRISMATIC joint slides along its axis instead of turning about it, so
       its joint value is a length in metres, not an angle in radians. -->
  <joint name="j2_slide" type="prismatic">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.10 0.05 0.12" rpy="-0.40 0.60 0.15"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.15" effort="50" velocity="0.5"/>
  </joint>

  <!-- The branch: a fixed camera bracket hanging off link2. -->
  <joint name="camera_mount" type="fixed">
    <parent link="link2"/><child link="camera_link"/>
    <origin xyz="0.0 0.10 0.03" rpy="0.9 0.0 -1.2"/>
  </joint>

  <!-- Axis written as "0 2 0": length 2, not 1.  A loader that forgets to
       normalise turns this joint through TWICE the commanded angle. -->
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.0 0.14 0.05" rpy="1.10 0.20 -0.70"/>
    <axis xyz="0 2 0"/>
    <limit lower="-2.2" upper="2.2" effort="40" velocity="3"/>
  </joint>

  <joint name="j4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.03 0.0 0.19" rpy="0.30 -1.20 0.25"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="2.0" effort="30" velocity="3"/>
  </joint>

  <joint name="j5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0.05 0.02 0.13" rpy="-0.90 0.40 0.60"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="20" velocity="3"/>
  </joint>

  <joint name="tool_fixed" type="fixed">
    <parent link="link5"/><child link="tool0"/>
    <origin xyz="0.03 0.0 0.09" rpy="0.40 0.20 -0.50"/>
  </joint>

</robot>
