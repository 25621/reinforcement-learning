<?xml version="1.0"?>
<!--
  arm2 - the textbook planar two-link arm, the smallest robot whose dynamics
  still has every term of the manipulator equation in it.

  Both joints rotate about y, so the whole arm stays in the x-z plane and
  gravity (-z) does real work on it.  Each link is a uniform rod of length L
  hanging along its own z axis, so its centre of mass sits at L/2 and its
  inertia about the transverse axes is m L^2 / 12.

  Why a rod and not a point mass?  A point mass would make the inertia terms
  vanish and hide half of what RNEA computes.  The rod keeps the arithmetic
  hand-checkable while still exercising ixx, iyy and izz.

  Units: metres, radians, kilograms.
-->
<robot name="arm2">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.03"/>
      <geometry><cylinder radius="0.06" length="0.06"/></geometry>
    </visual>
  </link>

  <!-- Link 1: uniform rod, m = 2 kg, L = 0.5 m, along +z of its own frame. -->
  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="2.0"/>
      <inertia ixx="0.0416666666666667" ixy="0" ixz="0"
               iyy="0.0416666666666667" iyz="0" izz="0.0009"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><cylinder radius="0.03" length="0.50"/></geometry>
    </visual>
  </link>

  <!-- Link 2: uniform rod, m = 1 kg, L = 0.4 m. -->
  <link name="link2">
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="1.0"/>
      <inertia ixx="0.0133333333333333" ixy="0" ixz="0"
               iyy="0.0133333333333333" iyz="0" izz="0.000225"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><cylinder radius="0.025" length="0.40"/></geometry>
    </visual>
  </link>

  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </visual>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="4.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.50" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.00" upper="3.00" effort="30" velocity="4.0"/>
  </joint>

  <joint name="tool_fixed" type="fixed">
    <parent link="link2"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
  </joint>

</robot>
