.idea/
prompts/
venv/
tmp/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Docusaurus generated files
docusaurus-site/.docusaurus/
docusaurus-site/build/
docusaurus-site/node_modules/
/docs/

# RL Phase 7 offline-RL dataset caches (~10 MB each). Not committed because they are
# fully regenerated in ~30s from the committed teacher policies in
# guides/reinforcement-learning/projects/38-bc-baseline-on-d4rl/teachers/.
guides/reinforcement-learning/projects/38-bc-baseline-on-d4rl/data/

# Multimodal Phase 1 shared cache: 1,000 COCO JPEGs (~15 MB) plus their CLIP
# embeddings (~19 MB), used by projects 02 and 03. Not committed because
# `python3 run.py --stage data` re-downloads and re-encodes them in ~2 minutes.
guides/multimodal-learning/projects/02-visualize-the-modality-gap/data/

# Multimodal Phase 2 dataset caches, all re-downloaded automatically on first run:
#   04  CIFAR-10 as npz (~170 MB), shared with project 08
#   05  Imagenette (~95 MB) plus the four encoders' cached features (~15 MB)
#   06  the Free Spoken Digit Dataset (~15 MB), shared with project 07
#   07  its own FSDD copy at 16 kHz plus pooled Whisper features (~10 MB)
guides/multimodal-learning/projects/04-implement-vit-from-scratch/data/
guides/multimodal-learning/projects/05-compare-encoders/data/
guides/multimodal-learning/projects/06-mel-spectrogram-pipeline/data/
guides/multimodal-learning/projects/07-whisper-encoder-reuse/data/

# Multimodal Phase 2 trained ViT checkpoints (3.3 MB each). Not committed because
# `python3 run.py --stage train` regenerates all three in ~9 minutes; every number
# they produced is already in outputs/training.json and outputs/shuffle.json.
guides/multimodal-learning/projects/04-implement-vit-from-scratch/outputs/*.pt

# Multimodal Phase 3 dataset caches, all re-downloaded automatically on first run:
#   10  5,000 COCO images at 72x72 as one npz (~55 MB) plus the word vocabulary.
#       This is the SHARED Phase-3 dataset -- projects 12, 13 and 14 read it from
#       10's directory rather than keeping copies.
#   11  Imagenette + Imagewoof (~95 MB each), cached CLIP image features, the
#       ImageNet class index, and the 1,000-class classifier weights (~2 MB each)
guides/multimodal-learning/projects/10-tiny-clip/data/
guides/multimodal-learning/projects/11-zero-shot-imagenet/data/

# Multimodal Phase 3 trained tiny-CLIP checkpoints and per-run metric caches
# (~6 MB per run). Not committed because every run is regenerated by its stage in
# a couple of minutes, and every number they produced is already in outputs/*.csv.
guides/multimodal-learning/projects/10-tiny-clip/checkpoints/
guides/multimodal-learning/projects/12-hard-negative-mining/checkpoints/
guides/multimodal-learning/projects/13-temperature-ablation/checkpoints/
guides/multimodal-learning/projects/14-data-filtering-with-clip/checkpoints/
