.idea/
prompts/
venv/
tmp/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Docusaurus generated files
docusaurus-site/.docusaurus/
docusaurus-site/build/
docusaurus-site/node_modules/
/docs/

# RL Phase 7 offline-RL dataset caches (~10 MB each). Not committed because they are
# fully regenerated in ~30s from the committed teacher policies in
# guides/reinforcement-learning/projects/38-bc-baseline-on-d4rl/teachers/.
guides/reinforcement-learning/projects/38-bc-baseline-on-d4rl/data/

# Multimodal Phase 1 shared cache: 1,000 COCO JPEGs (~15 MB) plus their CLIP
# embeddings (~19 MB), used by projects 02 and 03. Not committed because
# `python3 run.py --stage data` re-downloads and re-encodes them in ~2 minutes.
guides/multimodal-learning/projects/02-visualize-the-modality-gap/data/

# Multimodal Phase 2 dataset caches, all re-downloaded automatically on first run:
#   04  CIFAR-10 as npz (~170 MB), shared with project 08
#   05  Imagenette (~95 MB) plus the four encoders' cached features (~15 MB)
#   06  the Free Spoken Digit Dataset (~15 MB), shared with project 07
#   07  its own FSDD copy at 16 kHz plus pooled Whisper features (~10 MB)
guides/multimodal-learning/projects/04-implement-vit-from-scratch/data/
guides/multimodal-learning/projects/05-compare-encoders/data/
guides/multimodal-learning/projects/06-mel-spectrogram-pipeline/data/
guides/multimodal-learning/projects/07-whisper-encoder-reuse/data/

# Multimodal Phase 2 trained ViT checkpoints (3.3 MB each). Not committed because
# `python3 run.py --stage train` regenerates all three in ~9 minutes; every number
# they produced is already in outputs/training.json and outputs/shuffle.json.
guides/multimodal-learning/projects/04-implement-vit-from-scratch/outputs/*.pt

# Multimodal Phase 3 dataset caches, all re-downloaded automatically on first run:
#   10  5,000 COCO images at 72x72 as one npz (~55 MB) plus the word vocabulary.
#       This is the SHARED Phase-3 dataset -- projects 12, 13 and 14 read it from
#       10's directory rather than keeping copies.
#   11  Imagenette + Imagewoof (~95 MB each), cached CLIP image features, the
#       ImageNet class index, and the 1,000-class classifier weights (~2 MB each)
guides/multimodal-learning/projects/10-tiny-clip/data/
guides/multimodal-learning/projects/11-zero-shot-imagenet/data/

# Multimodal Phase 3 trained tiny-CLIP checkpoints and per-run metric caches
# (~6 MB per run). Not committed because every run is regenerated by its stage in
# a couple of minutes, and every number they produced is already in outputs/*.csv.
guides/multimodal-learning/projects/10-tiny-clip/checkpoints/
guides/multimodal-learning/projects/12-hard-negative-mining/checkpoints/
guides/multimodal-learning/projects/13-temperature-ablation/checkpoints/
guides/multimodal-learning/projects/14-data-filtering-with-clip/checkpoints/

# Multimodal Phase 4 caches, all regenerated by the projects' own stages:
#   15  the rendered shapes world plus the frozen encoder's cached patch tokens
#       (~42 MB per pretext variant), rebuilt by `run.py --stage vision` in ~1 min
#   16  3,000 COCO images encoded once by a frozen CLIP ViT-B/32 (~260 MB).
#       This is the SHARED Phase-4 caption cache -- project 19 reads it from 16's
#       directory rather than keeping a copy. Rebuilt in ~5 min.
#   17  Imagenette plus the depth maps estimated from it (~300 MB), rebuilt by
#       `run.py --stage data` in ~4 min
guides/multimodal-learning/projects/15-concat-vs-cross-attn/data/
guides/multimodal-learning/projects/15-concat-vs-cross-attn/data_whatonly/
guides/multimodal-learning/projects/16-implement-q-former/data/
guides/multimodal-learning/projects/17-adapter-for-a-new-modality/data/

# Multimodal Phase 4 frozen text-only caption LM (~14 MB). Regenerated by
# project 19's `--stage lm` in ~3 min; its only number is in outputs/text_lm.json.
guides/multimodal-learning/projects/19-gated-cross-attention/checkpoints/

# Multimodal Phase 5 caches, all rebuilt by the projects' own stages:
#   20  3,000 COCO images encoded once by a frozen CLIP ViT-B/32 at two taps
#       (~510 MB). This is the SHARED Phase-5 cache -- projects 21, 24 and 25
#       read it from 20's directory rather than keeping copies. Rebuilt in ~3 min
#       by `python3 run.py --stage data`.
#   22  1,600 rendered "document" pages, each encoded as five CLIP views
#       (~600 MB), rebuilt by `run.py --stage data` in ~5 min
#   23  2,600 rendered two-shape scenes plus their CLIP tokens (~190 MB),
#       rebuilt by `run.py --stage data` in ~2 min
guides/multimodal-learning/projects/20-llava-from-scratch/data/
guides/multimodal-learning/projects/22-dynamic-resolution/data/
guides/multimodal-learning/projects/23-grounding-head/data/

# Multimodal Phase 5 trained projectors (~3 MB each). Project 21 loads project
# 20's stage-1 projector from here, exactly as the real two-stage recipe does;
# every number they produced is already in outputs/*.json.
guides/multimodal-learning/projects/20-llava-from-scratch/checkpoints/

# Multimodal Phase 6 dataset caches, all rebuilt automatically on first run:
#   26  the 10-second demo clip plus the 1.1 MB steam-train download (~2 MB),
#       rebuilt by `run.py --stage picture` in seconds
#   28  EnCodec codes for 1,500 spoken digits (~15 MB), rebuilt in ~90 s
#   29  2,000 two-digit utterances plus two frozen-Whisper feature taps
#       (~320 MB), rebuilt by `run.py --stage data` in ~5 min
#   30  1,000 rendered clips plus their pooled frozen-CLIP features (~60 MB),
#       rebuilt by `run.py --stage data` in ~5 min. Project 31 regenerates the
#       same clips procedurally in ~5 s and caches nothing.
guides/multimodal-learning/projects/26-mel-spectrogram-from-scratch/data/
guides/multimodal-learning/projects/28-encodec-tour/data/
guides/multimodal-learning/projects/29-speech-llm/data/
guides/multimodal-learning/projects/30-video-frame-vlm/data/

# Multimodal Phase 6 trained weights: 27's fine-tuned Whisper copies (~150 MB
# each) and the projectors of 29 and 30 (~2 MB each). Every number they produced
# is already in outputs/*.json.
guides/multimodal-learning/projects/27-whisper-fine-tune/checkpoints/
guides/multimodal-learning/projects/29-speech-llm/checkpoints/
guides/multimodal-learning/projects/30-video-frame-vlm/checkpoints/
